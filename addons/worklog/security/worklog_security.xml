<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="worklog_time_entry_rule_user_own" model="ir.rule">
        <field name="name">Worklog Entry: Own Entries</field>
        <field name="model_id" ref="model_worklog_time_entry"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="worklog_time_entry_rule_admin_all" model="ir.rule">
        <field name="name">Worklog Entry: Admin Access</field>
        <field name="model_id" ref="model_worklog_time_entry"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
