<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_recompute_time_stats" model="ir.cron">
            <field name="name">Worklog: Recompute Time Window Stats</field>
            <field name="model_id" ref="model_worklog_project"/>
            <field name="state">code</field>
            <field name="code">
                for model in ['worklog.project', 'worklog.project.task', 'worklog.technology']:
                    records = env[model].search([])
                    records._compute_today_hours()
                    records._compute_last_7_days()
                    records._compute_last_30_days()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-01-01 03:00:00</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
