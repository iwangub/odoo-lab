<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TODO: add kanban   -->

    <record id="view_worklog_technology_list" model="ir.ui.view">
        <field name="name">worklog.technology.list</field>
        <field name="model">worklog.technology</field>
        <field name="arch" type="xml">
            <list string="technologies">
                <field name="name" />
                <field name="invested_time_total_hours" widget="float_time" readonly="1" />
            </list>
        </field>
    </record>

    <record id="view_worklog_technology_form" model="ir.ui.view">
        <field name="name">worklog.technology.form</field>
        <field name="model">worklog.technology</field>
        <field name="arch" type="xml">
            <form string="technology">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="invested_time_total_hours" widget="float_time" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

