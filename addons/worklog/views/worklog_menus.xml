<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_worklog_projects" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">worklog.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_worklog_project_search"/>
    </record>

    <record id="action_worklog_entries" model="ir.actions.act_window">
        <field name="name">Worklog</field>
        <field name="res_model">worklog.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_worklog_entry_search"/>
        <field name="context">{'search_default_my_entries': 1}</field>
    </record>

    <menuitem id="menu_worklog_root"
              name="Worklog"
              sequence="10"
              groups="base.group_user"/>

    <menuitem id="menu_worklog_projects"
              name="Projects"
              parent="menu_worklog_root"
              action="action_worklog_projects"
              sequence="10"
              groups="base.group_user"/>

    <menuitem id="menu_worklog_entries"
              name="Worklog"
              parent="menu_worklog_root"
              action="action_worklog_entries"
              sequence="20"
              groups="base.group_user"/>
</odoo>
