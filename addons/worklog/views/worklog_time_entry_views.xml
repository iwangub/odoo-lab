<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_worklog_time_entry_list" model="ir.ui.view">
        <field name="name">worklog.time.entry.list</field>
        <field name="model">worklog.time.entry</field>
        <field name="arch" type="xml">
            <list string="Worklog" default_order="start_time desc"
                  decoration-success="is_running">
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="user_id" groups="base.group_system" optional="hide"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration_hours" invisible="is_running" widget="float_time"
                       string="Duration"/>
                <field name="live_duration_hours" invisible="not is_running" widget="float_time"
                       string="Live"/>
                <field name="is_running" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_worklog_time_entry_form" model="ir.ui.view">
        <field name="name">worklog.time.entry.form</field>
        <field name="model">worklog.time.entry</field>
        <field name="arch" type="xml">
            <form string="Worklog Entry">
                <header>
                    <button name="action_start"
                            type="object"
                            string="Start"
                            class="btn-primary"
                            invisible="is_running or end_time"
                    />
                    <button name="action_stop"
                            type="object"
                            string="Stop"
                            class="btn-danger"
                            invisible="not is_running"
                    />
                    <button name="action_continue"
                            type="object"
                            string="Continue"
                            class="btn-secondary"
                            invisible="is_running or not end_time"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="task_id"/>
                            <field name="user_id" groups="base.group_system"/>
                            <field name="is_running" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_time"
                                   options="{'rounding': 60}"
                                   readonly="is_running"/>
                            <field name="end_time"
                                   options="{'rounding': 60}"
                                   readonly="is_running"/>
                            <field name="duration_hours" widget="float_time" readonly="1"
                                   string="Duration" invisible="is_running"/>
                            <field name="live_duration_hours" widget="float_time" readonly="1"
                                   string="Live Duration" invisible="not is_running"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_worklog_time_entry_search" model="ir.ui.view">
        <field name="name">worklog.time.entry.search</field>
        <field name="model">worklog.time.entry</field>
        <field name="arch" type="xml">
            <search string="Search Worklog">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter name="my_entries" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <filter name="running" string="Running" domain="[('is_running', '=', True)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[
        ('start_time', '&gt;=', context_today()),
        ('start_time', '&lt;', context_today() + relativedelta(days=1))
    ]"
                />
            </search>
        </field>
    </record>
</odoo>
