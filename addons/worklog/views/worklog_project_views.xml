<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_worklog_project_kanban" model="ir.ui.view">
        <field name="name">worklog.project.kanban</field>
        <field name="model">worklog.project</field>
        <field name="arch" type="xml">
            <kanban string="Projects" default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div invisible="state in ['1_draft']">
                                <div class="mt-2 text-muted small">
                                    <span>Today: <field name="today_hours" widget="float_time" class="d-inline"/>
                                        h</span>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <span>Last 7 Days: <field name="last_7_days_hours" widget="float_time"
                                                              class="d-inline"/> h</span>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <span>Last 30 Days: <field name="last_30_days_hours" widget="float_time"
                                                               class="d-inline"/> h</span>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <span>Total: <field name="total_time_hours" widget="float_time" class="d-inline"/>
                                        h</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_worklog_project_list" model="ir.ui.view">
        <field name="name">worklog.project.list</field>
        <field name="model">worklog.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="name"/>
                <field name="total_time_hours" widget="float_time" string="Total Time"/>
                <field name="today_hours" widget="float_time"/>
                <field name="last_7_days_hours" widget="float_time"/>
                <field name="last_30_days_hours" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_worklog_project_form" model="ir.ui.view">
        <field name="name">worklog.project.form</field>
        <field name="model">worklog.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="task_count" string="Tasks" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Project name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="today_hours" widget="float_time" readonly="1"/>
                            <field name="last_7_days_hours" widget="float_time" readonly="1"/>
                            <field name="last_30_days_hours" widget="float_time" readonly="1"/>
                            <field name="total_time_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_worklog_project_search" model="ir.ui.view">
        <field name="name">worklog.project.search</field>
        <field name="model">worklog.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name"/>
                <field name="description"/>
                <field name="state"/>
            </search>
        </field>
    </record>
</odoo>
