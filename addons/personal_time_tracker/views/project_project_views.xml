<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_list_view" model="ir.ui.view">
        <field name="name">project.project.list.view</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expression="">
                <button name="action_view_personal_time_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock">
                    <field name="total_personal_time"
                           widget="statinfo"
                           string="Hours"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
