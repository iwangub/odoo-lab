<odoo>
    <record id="personal_time_entry_rule_user_own" model="ir.rule">
        <field name="name">Personal Time Entry: Own Entries</field>
        <field name="model_id" ref="model_personal_time_entry"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="personal_time_entry_rule_manager_all" model="ir.rule">
        <field name="name">Personal Time Entry: Manager Access</field>
        <field name="model_id" ref="model_personal_time_entry"/>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
